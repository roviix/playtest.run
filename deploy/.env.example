# 复制成 deploy/.env 放在服务器上（chmod 600），不要提交。push.sh 不会覆盖它。

# Let's Encrypt 的通知邮箱。
ACME_EMAIL=you@example.com

# Cloudflare「Edit zone DNS」令牌，只授权 playtest.run 这一个区域。
# 空着 = 不启用玩家域名（content.caddy 不会被加载）。
CLOUDFLARE_API_TOKEN=

# 控制面（与控制台 /console/）的公网主机名：playtest.roviix.com（AGENTS 第 7 条，不能在 playtest.run 下）。
# 空着 = 不对公网暴露 api，CLI 用 ssh -L 8787:127.0.0.1:8787 playtest-hk 然后 PLAYTEST_API=http://127.0.0.1:8787。
API_HOST=

# GitHub OAuth App（Settings → Developer settings → OAuth Apps；要勾 Enable Device Flow）。
# client_id 公开；client_secret 只有控制台的网页登录要，终端的 playtest login 不用它。
# 都空着 = 不提供登录，匿名链接照常。
PLAYTEST_GITHUB_CLIENT_ID=
PLAYTEST_GITHUB_CLIENT_SECRET=
# GitHub 授权完回到哪：就是控制台自己的地址，须是 OAuth App 里登记的回调地址本身或其子路径。
PLAYTEST_CONSOLE_URL=https://playtest.roviix.com/console/

# 玩家浏览器里的 SDK 往哪发事件，一般就是 https://<API_HOST>。空着 = SDK 安静地不发（没有公网控制面时）。
PLAYTEST_API_PUBLIC_URL=

# 玩家链接的形态。本机开发是 http://{slug}.localhost:8443 / localhost / http。
PLAYTEST_SITE_URL_TEMPLATE=https://{slug}.playtest.run
PLAYTEST_HOST_SUFFIX=playtest.run
PLAYTEST_PUBLIC_SCHEME=https

# 本机目录只留 SQLite、上传临时文件、事件与用量账本；作品物料以 S3 为唯一持久源。
PLAYTEST_DATA_HOST_DIR=/home/ubuntu/playtest-data

# 生产 compose 默认 s3；只有本机开发才使用 fs。桶必须私有，endpoint 留空就是 AWS S3。
PLAYTEST_STORAGE_BACKEND=s3
PLAYTEST_S3_BUCKET=your-private-bucket
PLAYTEST_S3_REGION=ap-east-1
PLAYTEST_S3_ENDPOINT=
# 同一个桶还放别的东西时可加前缀，例如 production；空着就是桶根。
PLAYTEST_S3_PREFIX=production

# API 要 GetObject / PutObject / DeleteObject / ListBucket；edge 只要 GetObject / ListBucket。
# 在 EC2 / ECS 上也可以全部留空，改用实例或容器角色。三项密钥不入库、不写进日志。
PLAYTEST_S3_API_ACCESS_KEY_ID=
PLAYTEST_S3_API_SECRET_ACCESS_KEY=
PLAYTEST_S3_API_SESSION_TOKEN=
PLAYTEST_S3_EDGE_ACCESS_KEY_ID=
PLAYTEST_S3_EDGE_SECRET_ACCESS_KEY=
PLAYTEST_S3_EDGE_SESSION_TOKEN=

RUST_LOG=info
