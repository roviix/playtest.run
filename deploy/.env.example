# 复制成 deploy/.env 放在服务器上（chmod 600），不要提交。push.sh 不会覆盖它。

# Let's Encrypt 的通知邮箱。
ACME_EMAIL=you@example.com

# Cloudflare「Edit zone DNS」令牌，只授权 playtest.run 这一个区域。
# 空着 = 不启用玩家域名（content.caddy 不会被加载）。
CLOUDFLARE_API_TOKEN=

# 控制面（与控制台 /console/）的公网主机名：playtest.roviix.com（AGENTS 第 7 条，不能在 playtest.run 下）。
# 空着 = 不对公网暴露 api，CLI 用 ssh -L 8787:127.0.0.1:8787 playtest-hk 然后 PLAYTEST_API=http://127.0.0.1:8787。
API_HOST=

# 玩家浏览器里的 SDK 往哪发事件，一般就是 https://<API_HOST>。空着 = SDK 安静地不发（没有公网控制面时）。
PLAYTEST_API_PUBLIC_URL=

# 玩家链接的形态。本机开发是 http://{slug}.localhost:8443 / localhost / http。
PLAYTEST_SITE_URL_TEMPLATE=https://{slug}.playtest.run
PLAYTEST_HOST_SUFFIX=playtest.run
PLAYTEST_PUBLIC_SCHEME=https

# api 与 edge 共用的数据目录（对象存储、SQLite、事件日志）在主机上的位置。
PLAYTEST_DATA_HOST_DIR=/home/ubuntu/playtest-data

RUST_LOG=info
