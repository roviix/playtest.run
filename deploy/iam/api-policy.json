{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PlaytestApiBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::${PLAYTEST_S3_BUCKET}"
    },
    {
      "Sid": "PlaytestApiObjectOperations",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::${PLAYTEST_S3_BUCKET}/*"
    }
  ]
}
