{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PlaytestEdgeBucketListing",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::${PLAYTEST_S3_BUCKET}"
    },
    {
      "Sid": "PlaytestEdgeReadOnlyObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::${PLAYTEST_S3_BUCKET}/*"
    }
  ]
}
