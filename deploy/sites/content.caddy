# 玩家看到的一切：根域介绍页与每个作品的 <slug>.playtest.run。
# 泛域名证书走 DNS-01（Cloudflare API），一张证书覆盖所有 slug。
playtest.run, *.playtest.run {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# 用公共解析器查 TXT 记录是否已生效，避免主机本地 DNS 缓存拖慢签发。
		resolvers 1.1.1.1 1.0.0.1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	@console host playtest.run
	@console_paths {
		host playtest.run
		path /console/*
	}
	@console_root {
		host playtest.run
		path /console
	}
	@api {
		host playtest.run
		path /v1/* /healthz /health /llms.txt /llms-full.txt /skill.md /openapi.json /.well-known/agent.json
	}
	@install {
		host playtest.run
		path /install.sh
	}

	header @console {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
	redir @console_root /console/ permanent
	handle @console_paths {
		uri strip_prefix /console
		root * /srv/console
		encode zstd gzip
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	handle @api {
		reverse_proxy api:8787 {
			flush_interval -1
		}
	}
	handle @install {
		root * /srv/site
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	handle {
		reverse_proxy edge:8443 {
			flush_interval -1
		}
	}
}
